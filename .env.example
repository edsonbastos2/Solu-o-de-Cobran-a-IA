# GROQ_API_KEY: Groq API key.
# Get yours at https://console.groq.com/keys
# Esta é a variável de ÚLTIMO RECURSO (fallback hardcoded) para os buckets
# assistant e agents, concentrada em lib/ai-config.ts. Quando nem o tenant
# nem o padrão de sistema configuram esses buckets, o resolvedor usa
# groq + GROQ_API_KEY (modelo llama-3.3-70b-versatile).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# OPENCODE_API_KEY: OpenCode Zen API key.
# Get yours at https://opencode.ai/auth
# Fallback hardcoded do bucket pdf_extraction apenas (lib/ai-config.ts) —
# opencode + OPENCODE_API_KEY, modelo minimax-m3 (visão de documento/PDF).
# Groq não tem modelo com suporte nativo a PDF, por isso não assume esse bucket.
OPENCODE_API_KEY="YOUR_OPENCODE_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Chaves de provedores de IA (fallback transitório — ticket 1804).
# Estas env-vars atuam como fallback DENTRO de cada step do resolvedor quando
# um bucket do tenant declara o provedor mas NÃO traz segredo salvo (preserva o
# comportamento pré-migração de tenants que dependiam de env). Não são o
# fallback final — esse é GROQ_API_KEY (assistant/agents) ou OPENCODE_API_KEY
# (pdf_extraction) acima. Rotas/UI não leem essas vars diretamente; o acesso é
# centralizado em lib/ai-config.ts (envKeyFor).
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# You must create a Supabase project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Z-API Configuration
# Get these from your Z-API dashboard at https://app.z-api.io/
ZAPI_INSTANCE_ID="YOUR_ZAPI_INSTANCE_ID"
ZAPI_TOKEN="YOUR_ZAPI_TOKEN"
ZAPI_CLIENT_TOKEN="YOUR_ZAPI_CLIENT_TOKEN"

# Telegram Configuration
# Create a bot via @BotFather on Telegram and get the token:
# https://t.me/BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Messaging provider (whatsapp or telegram)
# Controls the default messaging provider when not set per-user
MESSAGING_PROVIDER="whatsapp"

# Webhook security
# Random secret used to validate incoming Z-API and Telegram webhooks
WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Cron jobs security (required for /api/cron/* routes)
CRON_SECRET="YOUR_CRON_SECRET"

# Upstash Redis (rate limiter multi-instância)
# Optional — se ausente, o app usa fallback in-memory (modo demo/instância única).
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL="YOUR_UPSTASH_REDIS_REST_URL"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# Sentry (observabilidade)
# Optional — se ausente, o logger usa console estruturado.
SENTRY_DSN="YOUR_SENTRY_DSN"

# E-mail transacional (SMTP via Nodemailer) — convite de equipe do tenant (ticket 1805)
# API própria de envio, substitui a dependência do SMTP configurado no painel
# do Supabase para o fluxo de convite. Sem essas variáveis, o convite ainda é
# criado (pending), mas o e-mail não é enviado — a rota retorna 502.
# Exemplo com Gmail: ative a verificação em 2 etapas na conta e gere uma
# "senha de app" em https://myaccount.google.com/apppasswords — use-a em
# SMTP_PASS (não a senha normal da conta).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="YOUR_APP_PASSWORD"
# Remetente exibido, ex.: "CobrançaIA <seuemail@gmail.com>" — o e-mail deve ser
# o mesmo autenticado em SMTP_USER (Gmail rejeita remetente divergente).
EMAIL_FROM="YOUR_SENDER"

# Negativação (tarefa 8)
# Optional — se ausente, usa 60 dias como prazo padrão para negativação.
DEFAULT_DAYS_TO_NEGATIVE="60"
# Optional — provider de negativação (serasa, spc, boavista ou auto).
NEGATIVATION_PROVIDER="auto"

# Protesto em cartório (tarefa 9)
# Optional — se ausente, usa 90 dias como prazo padrão para protesto.
DEFAULT_DAYS_TO_PROTEST="90"
# Optional — provider de protesto (cartorio, central, protesto_online ou auto).
PROTEST_PROVIDER="auto"

# Pipeline jurídico (tarefa 10)
# Optional — dias dentro do estágio 'especializada' antes do escalonamento automático.
DEFAULT_LEGAL_ESCALATION_DAYS="60"
